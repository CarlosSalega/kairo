# =============================================================================
# KAIRO — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Kairo

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/kairo
DIRECT_URL=postgresql://user:password@localhost:5432/kairo

# -----------------------------------------------------------------------------
# Auth (NextAuth / Clerk / Auth.js — completar según provider elegido)
# -----------------------------------------------------------------------------
AUTH_SECRET=

# Clerk (si se usa Clerk)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# AWS S3 / R2 (Cloudflare)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_REGION=
# S3_ENDPOINT=

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Redis directo
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Search
# -----------------------------------------------------------------------------

# Algolia
# ALGOLIA_APP_ID=
# ALGOLIA_API_KEY=
# NEXT_PUBLIC_ALGOLIA_APP_ID=
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=

# Meilisearch
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------

# Google Analytics 4
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# PostHog
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Revalidation
# -----------------------------------------------------------------------------
REVALIDATE_SECRET=
