{
  "name": "kairo",
  "version": "0.1.0",
  "description": "Open source ecommerce framework for Next.js",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Kairo Contributors",
    "url": "https://github.com/kairo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kairo/kairo.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx src/core/database/seeds/index.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "validate": "pnpm type-check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "@prisma/client": "7.8.0",
    "server-only": "0.0.1",
    "zod": "4.4.3",
    "next-safe-action": "8.5.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "nuqs": "2.8.9",
    "zustand": "5.0.13",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "class-variance-authority": "0.7.1",
    "lucide-react": "1.16.0",
    "tw-animate-css": "1.4.0",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "cmdk": "1.1.1",
    "sonner": "2.0.7",
    "vaul": "1.1.2",
    "@upstash/redis": "1.38.0",
    "@upstash/ratelimit": "2.0.8",
    "resend": "6.12.3",
    "cloudinary": "2.10.0",
    "slugify": "1.6.9",
    "date-fns": "4.3.0",
    "sharp": "0.34.5",
    "geist": "1.3.1"
  },
  "devDependencies": {
    "prisma": "7.8.0",
    "tsx": "4.22.3",
    "typescript": "5.9.3",
    "@types/node": "20.19.41",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.3.0",
    "@tailwindcss/postcss": "4.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "vitest": "4.1.7",
    "@vitest/coverage-v8": "3.2.4",
    "@vitejs/plugin-react": "6.0.2",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "jsdom": "29.1.1",
    "@types/jsdom": "28.0.3",
    "@playwright/test": "1.60.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
